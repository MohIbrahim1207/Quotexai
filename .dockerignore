# Version Control
.git
.gitignore

# Environment & Secrets (CRITICAL SECURITY)
.env
.env.*
*.env
*.pem
*.key
self_client.json
self_client*.json
*tokens*.json
zoho_tokens.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Transient data & outputs
scratch/
outputs/*
!outputs/.gitkeep
uploads/*
!uploads/.gitkeep

# OS / Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
